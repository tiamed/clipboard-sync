#!/bin/bash
#
# clipboard-sync — push-oriented bidirectional clipboard sync
# Linux (Wayland) ↔ macOS over persistent SSH multiplexing.
#
# Architecture (v2 push):
#   • Outbound worker: wl-paste --watch → SSH push (never blocks inbound)
#   • Inbound worker:  persistent SSH stream of Mac FIFO events with payload
#                      (TEXT base64 applied locally; IMGFILE scp'd once)
#   • Directions run in parallel; shared hashes + flock stop echo loops
#   • Failures are logged (not swallowed); rare safety-net poll as fallback
#
# Config: ~/.config/clipboard-sync/config.ini
# State:  ~/.local/state/clipboard-sync/
#

set -euo pipefail

# === CONFIGURATION DEFAULTS ===
declare -g REMOTE_USER=""
declare -g REMOTE_HOST=""
declare -g MACOS_IMAGE_COPY_PATH=""
declare -g MIN_LENGTH="1"
declare -g POLL_INTERVAL="30"
declare -g ENABLE_TEXT="true"
declare -g ENABLE_IMAGE="true"
declare -g USE_WAYLAND_WATCH="true"
declare -g MACOS_EVENT_MODE="fifo"
declare -g MACOS_EVENT_FIFO="/tmp/clipboard-sync.fifo"
declare -g MACOS_PUSH_IMAGE="/tmp/clipboard-sync-push.png"
declare -g MACOS_IMAGE_CHECK_INTERVAL="5"
declare -g NOTIFICATIONS_ENABLED="true"
declare -g SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3"
declare -g SSH_MUX_ENABLED="true"
declare -g SSH_MUX_PERSIST="600"

# === PATHS ===
readonly CONFIG_FILE="${CLIPBOARD_SYNC_CONFIG:-$HOME/.config/clipboard-sync/config.ini}"
readonly STATE_DIR="${CLIPBOARD_SYNC_STATE:-$HOME/.local/state/clipboard-sync}"
readonly STATE_TEXT_HASH="$STATE_DIR/text_hash"
readonly STATE_IMAGE_HASH="$STATE_DIR/image_hash"
readonly STATE_MACOS_CHANGE_COUNT="$STATE_DIR/macos_change_count"
readonly LOCK_FILE="$STATE_DIR/sync.lock"
readonly SSH_MUX_DIR="$HOME/.cache/clipboard-sync/ssh-mux"
TEMP_DIR=""

# === RUNTIME PIDS ===
OUTBOUND_PID=""
INBOUND_PID=""
SAFETY_PID=""
CLEANUP_DONE="false"

# === INI PARSER ===
parse_config() {
    local config_file="$1"
    local current_section=""

    if [[ ! -f "$config_file" ]]; then
        echo "Warning: Config file not found at $config_file, using defaults" >&2
        return 1
    fi

    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" ]] && continue
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ "$line" =~ ^[[:space:]]*$ ]] && continue

        if [[ "$line" =~ ^\[([^\]]+)\] ]]; then
            current_section="${BASH_REMATCH[1]}"
            continue
        fi

        if [[ "$line" =~ ^([^=]+)=(.*)$ ]]; then
            local key="${BASH_REMATCH[1]}"
            local value="${BASH_REMATCH[2]}"
            key="${key#"${key%%[![:space:]]*}"}"
            key="${key%"${key##*[![:space:]]}"}"
            value="${value#"${value%%[![:space:]]*}"}"
            value="${value%"${value##*[![:space:]]}"}"

            case "$current_section" in
                remote)
                    case "$key" in
                        user) REMOTE_USER="$value" ;;
                        host) REMOTE_HOST="$value" ;;
                        image_copy_path) MACOS_IMAGE_COPY_PATH="$value" ;;
                    esac
                    ;;
                sync)
                    case "$key" in
                        min_length) MIN_LENGTH="$value" ;;
                        poll_interval) POLL_INTERVAL="$value" ;;
                        enable_text) ENABLE_TEXT="$value" ;;
                        enable_image) ENABLE_IMAGE="$value" ;;
                        use_wayland_watch) USE_WAYLAND_WATCH="$value" ;;
                        macos_event_mode) MACOS_EVENT_MODE="$value" ;;
                        macos_event_fifo) MACOS_EVENT_FIFO="$value" ;;
                        macos_push_image) MACOS_PUSH_IMAGE="$value" ;;
                        macos_image_check_interval) MACOS_IMAGE_CHECK_INTERVAL="$value" ;;
                    esac
                    ;;
                notifications)
                    case "$key" in
                        enabled) NOTIFICATIONS_ENABLED="$value" ;;
                    esac
                    ;;
                ssh)
                    case "$key" in
                        options) SSH_OPTS="$value" ;;
                        mux_enabled) SSH_MUX_ENABLED="$value" ;;
                        mux_persist) SSH_MUX_PERSIST="$value" ;;
                    esac
                    ;;
            esac
        fi
    done < "$config_file"
    return 0
}

validate_config() {
    local errors=0
    if [[ -z "$REMOTE_USER" ]]; then
        echo "Error: remote.user not configured" >&2
        errors=$((errors + 1))
    fi
    if [[ -z "$REMOTE_HOST" ]]; then
        echo "Error: remote.host not configured" >&2
        errors=$((errors + 1))
    fi
    if [[ $errors -gt 0 ]]; then
        echo "Please configure $CONFIG_FILE" >&2
        return 1
    fi
    return 0
}

# === SETUP / CLEANUP ===
setup() {
    TEMP_DIR=$(mktemp -d /tmp/clipboard_sync.XXXXXX)
    chmod 700 "$TEMP_DIR"
    mkdir -p "$STATE_DIR"
    chmod 700 "$STATE_DIR" 2>/dev/null || true
    if [[ "$SSH_MUX_ENABLED" == "true" ]]; then
        mkdir -p "$SSH_MUX_DIR"
        chmod 700 "$SSH_MUX_DIR" 2>/dev/null || true
    fi
    touch "$STATE_TEXT_HASH" "$STATE_IMAGE_HASH" "$LOCK_FILE"
}

cleanup() {
    if [[ "$CLEANUP_DONE" == "true" ]]; then
        return
    fi
    CLEANUP_DONE="true"

    local pid
    for pid in "$OUTBOUND_PID" "$INBOUND_PID" "$SAFETY_PID"; do
        if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            sleep 0.15
            kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
        fi
    done

    [[ -n "${TEMP_DIR:-}" ]] && rm -rf "$TEMP_DIR" 2>/dev/null || true

    if [[ "$SSH_MUX_ENABLED" == "true" ]] && [[ -n "${REMOTE_USER:-}" ]] && [[ -n "${REMOTE_HOST:-}" ]]; then
        local socket
        socket=$(get_ssh_socket 2>/dev/null) || true
        if [[ -n "${socket:-}" ]] && [[ -S "$socket" ]]; then
            ssh -O exit -S "$socket" "$REMOTE_USER@$REMOTE_HOST" 2>/dev/null || true
        fi
    fi
}

handle_shutdown() {
    log_info "Shutting down..."
    cleanup
    exit 0
}

# === LOGGING ===
log() {
    local level="$1"
    shift
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [$level] $*" >&2
}
log_info()  { log "INFO" "$@"; }
log_warn()  { log "WARN" "$@"; }
log_error() { log "ERROR" "$@"; }
log_debug() {
    if [[ "${DEBUG:-false}" == "true" ]]; then
        log "DEBUG" "$@"
    fi
}

# === SSH MULTIPLEXING ===
get_ssh_socket() {
    local conn_string="${REMOTE_USER}@${REMOTE_HOST}"
    local socket_hash
    socket_hash=$(printf '%s' "$conn_string" | md5sum | awk '{print $1}' | cut -c1-16)
    echo "$SSH_MUX_DIR/$socket_hash"
}

ensure_ssh_master() {
    if [[ "$SSH_MUX_ENABLED" != "true" ]]; then
        return 0
    fi

    local socket
    socket=$(get_ssh_socket)

    if [[ -S "$socket" ]]; then
        if ssh -O check -S "$socket" "$REMOTE_USER@$REMOTE_HOST" 2>/dev/null; then
            return 0
        fi
        rm -f "$socket"
    elif [[ -e "$socket" ]]; then
        rm -f "$socket"
    fi

    log_info "Opening SSH master to $REMOTE_USER@$REMOTE_HOST"
    # shellcheck disable=SC2086
    if ! ssh -fN -M -S "$socket" \
        -o ControlPersist="$SSH_MUX_PERSIST" \
        $SSH_OPTS \
        "$REMOTE_USER@$REMOTE_HOST" 2>"$TEMP_DIR/ssh_master.err"; then
        log_error "SSH master failed: $(tr '\n' ' ' < "$TEMP_DIR/ssh_master.err" 2>/dev/null || true)"
        return 1
    fi

    local waited=0
    while [[ ! -S "$socket" ]] && [[ $waited -lt 50 ]]; do
        sleep 0.1
        waited=$((waited + 1))
    done

    if [[ -S "$socket" ]]; then
        return 0
    fi
    log_error "SSH master socket not created"
    return 1
}

# Run remote command over mux (stderr preserved to log file on failure)
ssh_run() {
    local errf="$TEMP_DIR/ssh_run_$$.err"
    local rc=0
    if [[ "$SSH_MUX_ENABLED" == "true" ]]; then
        local socket
        socket=$(get_ssh_socket)
        # shellcheck disable=SC2086
        ssh -S "$socket" -T $SSH_OPTS "$REMOTE_USER@$REMOTE_HOST" "$@" 2>"$errf" || rc=$?
    else
        # shellcheck disable=SC2086
        ssh -T $SSH_OPTS "$REMOTE_USER@$REMOTE_HOST" "$@" 2>"$errf" || rc=$?
    fi
    if [[ $rc -ne 0 ]]; then
        local err
        err=$(tr '\n' ' ' < "$errf" 2>/dev/null || true)
        [[ -n "$err" ]] && log_warn "ssh failed (rc=$rc): $err"
    fi
    rm -f "$errf"
    return $rc
}

# Pipe stdin to remote command
ssh_pipe() {
    local errf="$TEMP_DIR/ssh_pipe_$$.err"
    local rc=0
    if [[ "$SSH_MUX_ENABLED" == "true" ]]; then
        local socket
        socket=$(get_ssh_socket)
        # shellcheck disable=SC2086
        ssh -S "$socket" -T $SSH_OPTS "$REMOTE_USER@$REMOTE_HOST" "$@" 2>"$errf" || rc=$?
    else
        # shellcheck disable=SC2086
        ssh -T $SSH_OPTS "$REMOTE_USER@$REMOTE_HOST" "$@" 2>"$errf" || rc=$?
    fi
    if [[ $rc -ne 0 ]]; then
        local err
        err=$(tr '\n' ' ' < "$errf" 2>/dev/null || true)
        [[ -n "$err" ]] && log_warn "ssh pipe failed (rc=$rc): $err"
    fi
    rm -f "$errf"
    return $rc
}

scp_to() {
    local src="$1" dst="$2"
    local errf="$TEMP_DIR/scp_$$.err"
    local rc=0
    if [[ "$SSH_MUX_ENABLED" == "true" ]]; then
        local socket
        socket=$(get_ssh_socket)
        # shellcheck disable=SC2086
        scp -o ControlPath="$socket" -q $SSH_OPTS "$src" "$REMOTE_USER@$REMOTE_HOST:$dst" 2>"$errf" || rc=$?
    else
        # shellcheck disable=SC2086
        scp -q $SSH_OPTS "$src" "$REMOTE_USER@$REMOTE_HOST:$dst" 2>"$errf" || rc=$?
    fi
    if [[ $rc -ne 0 ]]; then
        log_warn "scp to remote failed (rc=$rc): $(tr '\n' ' ' < "$errf" 2>/dev/null || true)"
    fi
    rm -f "$errf"
    return $rc
}

scp_from() {
    local src="$1" dst="$2"
    local errf="$TEMP_DIR/scp_$$.err"
    local rc=0
    if [[ "$SSH_MUX_ENABLED" == "true" ]]; then
        local socket
        socket=$(get_ssh_socket)
        # shellcheck disable=SC2086
        scp -o ControlPath="$socket" -q $SSH_OPTS "$REMOTE_USER@$REMOTE_HOST:$src" "$dst" 2>"$errf" || rc=$?
    else
        # shellcheck disable=SC2086
        scp -q $SSH_OPTS "$REMOTE_USER@$REMOTE_HOST:$src" "$dst" 2>"$errf" || rc=$?
    fi
    if [[ $rc -ne 0 ]]; then
        log_warn "scp from remote failed (rc=$rc): $(tr '\n' ' ' < "$errf" 2>/dev/null || true)"
    fi
    rm -f "$errf"
    return $rc
}

check_connection() {
    ensure_ssh_master || return 1
    if [[ "$SSH_MUX_ENABLED" == "true" ]]; then
        local socket
        socket=$(get_ssh_socket)
        ssh -O check -S "$socket" "$REMOTE_USER@$REMOTE_HOST" 2>/dev/null
    else
        # shellcheck disable=SC2086
        ssh -n $SSH_OPTS "$REMOTE_USER@$REMOTE_HOST" "true" 2>/dev/null
    fi
}

# === HASH / STATE (flock-protected) ===
ensure_utf8() {
    local input="$1"
    printf '%s' "$input" | iconv -f UTF-8 -t UTF-8 -c 2>/dev/null | tr -d '\000' || printf '%s' "$input"
}

get_text_hash() {
    printf '%s' "$1" | sed 's/[[:space:]]*$//' | sha256sum | awk '{print $1}'
}

get_file_hash() {
    sha256sum "$1" | awk '{print $1}'
}

get_image_hash() {
    local file="$1"
    local hash=""

    if command -v python3 >/dev/null 2>&1; then
        hash=$(python3 - "$file" <<'PY' 2>/dev/null || true
import hashlib
import sys
try:
    from PIL import Image, ImageOps
    path = sys.argv[1]
    with Image.open(path) as img:
        img = ImageOps.exif_transpose(img).convert("RGBA")
        digest = hashlib.sha256()
        digest.update(b"img-v1\0")
        digest.update(str(img.size[0]).encode("ascii"))
        digest.update(b"x")
        digest.update(str(img.size[1]).encode("ascii"))
        digest.update(b"\0RGBA\0")
        digest.update(img.tobytes())
        print(digest.hexdigest())
except Exception:
    sys.exit(1)
PY
)
        if [[ -n "$hash" ]]; then
            echo "$hash"
            return 0
        fi
    fi

    if command -v magick >/dev/null 2>&1; then
        hash=$(magick "$file" -auto-orient -alpha on rgba:- 2>/dev/null | sha256sum | awk '{print $1}') || hash=""
        if [[ -n "$hash" ]]; then
            local geometry
            geometry=$(magick identify -format '%w:%h' "$file" 2>/dev/null || echo "")
            echo "magick:${geometry}:${hash}"
            return 0
        fi
    fi

    get_file_hash "$file"
}

with_lock() {
    (
        flock -w 5 9 || { log_warn "lock timeout"; exit 1; }
        "$@"
    ) 9>"$LOCK_FILE"
}

read_text_hash() { cat "$STATE_TEXT_HASH" 2>/dev/null || echo ""; }
read_image_hash() { cat "$STATE_IMAGE_HASH" 2>/dev/null || echo ""; }

write_text_hash() {
    printf '%s' "$1" > "$STATE_TEXT_HASH"
}
write_image_hash() {
    printf '%s' "$1" > "$STATE_IMAGE_HASH"
}

# === NOTIFICATIONS ===
escape_notification() {
    local text="$1"
    echo " $text" | sed 's/%/%%/g; s/\\/\\\\/g; s/"/\\"/g'
}

notify_linux() {
    [[ "$NOTIFICATIONS_ENABLED" == "true" ]] || return 0
    local title="$1" content="$2"
    notify-send "$(escape_notification "$title")" "$(escape_notification "$content")" 2>/dev/null || true
}

notify_macos() {
    [[ "$NOTIFICATIONS_ENABLED" == "true" ]] || return 0
    local title="$1" content="$2" truncated
    if [[ ${#content} -gt 100 ]]; then
        truncated="${content:0:100}..."
    else
        truncated="$content"
    fi
    truncated=$(printf '%s' "$truncated" | sed 's/\\/\\\\/g; s/"/\\"/g')
    title=$(printf '%s' "$title" | sed 's/\\/\\\\/g; s/"/\\"/g')
    printf 'display notification "%s" with title "%s"' "$truncated" "$title" | \
        ssh_pipe "export LC_CTYPE=en_US.UTF-8; osascript -" || true
}

# === PUSH / APPLY ===
push_text_to_macos() {
    local text="$1"
    printf '%s' "$text" | ssh_pipe "export LC_CTYPE=en_US.UTF-8; pbcopy"
}

push_image_to_macos() {
    local img="$1"
    if [[ -z "$MACOS_IMAGE_COPY_PATH" ]]; then
        log_error "remote.image_copy_path not set; cannot push images"
        return 1
    fi
    scp_to "$img" "/tmp/clipboard_sync.png" || return 1
    ssh_run "$MACOS_IMAGE_COPY_PATH /tmp/clipboard_sync.png && rm -f /tmp/clipboard_sync.png"
}

apply_text_to_linux() {
    local text="$1"
    printf '%s' "$text" | timeout 3 wl-copy -t text/plain
}

apply_image_to_linux() {
    local img="$1"
    timeout 3 wl-copy --type image/png < "$img"
}

# === OUTBOUND: Linux → macOS ===
handle_linux_text_change() {
    [[ "$ENABLE_TEXT" == "true" ]] || return 0

    local linux_text
    linux_text=$(timeout 2 wl-paste -t text/plain 2>/dev/null || echo "")
    [[ ${#linux_text} -ge $MIN_LENGTH ]] || return 0

    linux_text=$(ensure_utf8 "$linux_text")
    local current_hash last
    current_hash=$(get_text_hash "$linux_text")
    last=$(read_text_hash)
    [[ "$current_hash" == "$last" ]] && return 0

    if ! ensure_ssh_master; then
        log_error "outbound text: SSH unavailable"
        return 1
    fi

    if push_text_to_macos "$linux_text"; then
        with_lock write_text_hash "$current_hash"
        log_info "→ macOS text (${#linux_text} chars)"
        notify_macos "Clipboard Sync" "$linux_text"
    else
        log_error "→ macOS text push failed"
        return 1
    fi
}

handle_linux_image_change() {
    [[ "$ENABLE_IMAGE" == "true" ]] || return 0

    local image_type
    image_type=$(timeout 2 wl-paste --list-types 2>/dev/null | grep -m1 "image/" || echo "")
    [[ -n "$image_type" ]] || return 0

    local tmp_img="$TEMP_DIR/linux_out.$$.${image_type#image/}"
    if ! timeout 2 wl-paste --type "$image_type" > "$tmp_img" 2>/dev/null || [[ ! -s "$tmp_img" ]]; then
        rm -f "$tmp_img"
        return 0
    fi

    local current_hash
    current_hash=$(get_image_hash "$tmp_img")
    local last
    last=$(read_image_hash)
    if [[ "$current_hash" == "$last" ]]; then
        rm -f "$tmp_img"
        return 0
    fi

    if ! ensure_ssh_master; then
        log_error "outbound image: SSH unavailable"
        rm -f "$tmp_img"
        return 1
    fi

    if push_image_to_macos "$tmp_img"; then
        with_lock write_image_hash "$current_hash"
        log_info "→ macOS image"
        notify_macos "Clipboard Sync" "Image received from Linux"
    else
        log_error "→ macOS image push failed"
        rm -f "$tmp_img"
        return 1
    fi
    rm -f "$tmp_img"
}

wl_paste_watch_supported() {
    command -v wl-paste >/dev/null 2>&1 || return 1
    wl-paste --help 2>&1 | grep -q -- '--watch'
}

wayland_watch_available() {
    [[ "$USE_WAYLAND_WATCH" == "true" ]] || return 1
    if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
        log_warn "WAYLAND_DISPLAY not set; outbound falls back to polling"
        return 1
    fi
    if ! command -v wl-paste >/dev/null 2>&1; then
        log_warn "wl-paste not found; outbound falls back to polling"
        return 1
    fi
    if ! wl_paste_watch_supported; then
        log_warn "wl-paste lacks --watch (use original wl-clipboard); outbound polling"
        return 1
    fi
    return 0
}

# Outbound worker: event-driven Wayland → push (own process)
run_outbound_watch_worker() {
    log_info "Outbound worker: Wayland watch mode"

    # Separate loops so text and image never block each other.
    (
        while true; do
            # wl-paste --watch runs the command on each clipboard change
            if ! wl-paste --type text --watch printf 'T\n' 2>"$TEMP_DIR/wl_text.err" | while IFS= read -r _; do
                handle_linux_text_change || true
            done; then
                log_warn "text watch pipeline ended: $(tr '\n' ' ' < "$TEMP_DIR/wl_text.err" 2>/dev/null || true)"
            fi
            sleep 0.5
        done
    ) &
    local text_loop_pid=$!

    (
        while true; do
            if ! wl-paste --type image/png --watch printf 'I\n' 2>"$TEMP_DIR/wl_img.err" | while IFS= read -r _; do
                handle_linux_image_change || true
            done; then
                log_warn "image watch pipeline ended: $(tr '\n' ' ' < "$TEMP_DIR/wl_img.err" 2>/dev/null || true)"
            fi
            sleep 0.5
        done
    ) &
    local img_loop_pid=$!

    wait "$text_loop_pid" "$img_loop_pid" 2>/dev/null || true
}

run_outbound_poll_worker() {
    log_info "Outbound worker: polling every ${POLL_INTERVAL}s (min 1s for outbound)"
    local interval="$POLL_INTERVAL"
    [[ "$interval" -lt 1 ]] && interval=1
    # When inbound is push-based, outbound poll can stay fairly responsive
    if [[ "$MACOS_EVENT_MODE" == "fifo" ]] && [[ "$interval" -gt 2 ]]; then
        interval=1
    fi
    while true; do
        handle_linux_text_change || true
        handle_linux_image_change || true
        sleep "$interval"
    done
}

# === INBOUND: macOS → Linux (push payload) ===
apply_macos_text_payload() {
    local b64="$1"
    local mac_text
    if ! mac_text=$(printf '%s' "$b64" | base64 -d 2>/dev/null); then
        log_warn "← invalid TEXT base64"
        return 1
    fi
    [[ ${#mac_text} -ge $MIN_LENGTH ]] || return 0
    mac_text=$(ensure_utf8 "$mac_text")
    local current_hash
    current_hash=$(get_text_hash "$mac_text")
    local last
    last=$(read_text_hash)
    [[ "$current_hash" == "$last" ]] && return 0

    if apply_text_to_linux "$mac_text"; then
        with_lock write_text_hash "$current_hash"
        log_info "← Linux text (${#mac_text} chars) [push]"
        notify_linux "Clipboard Sync" "$mac_text"
    else
        log_error "← wl-copy text failed"
        return 1
    fi
}

apply_macos_imgfile() {
    local remote_path="$1"
    # Path must be absolute under /tmp for safety
    if [[ "$remote_path" != /tmp/* ]] || [[ "$remote_path" == *..* ]] || [[ "$remote_path" == *$'\n'* ]]; then
        log_warn "← rejected IMGFILE path: $remote_path"
        return 1
    fi

    local tmp_img="$TEMP_DIR/macos_in.$$.png"
    if ! scp_from "$remote_path" "$tmp_img"; then
        log_error "← scp IMGFILE failed"
        return 1
    fi
    if [[ ! -s "$tmp_img" ]]; then
        rm -f "$tmp_img"
        log_warn "← empty IMGFILE"
        return 1
    fi

    local current_hash
    current_hash=$(get_image_hash "$tmp_img")
    local last
    last=$(read_image_hash)
    if [[ "$current_hash" == "$last" ]]; then
        rm -f "$tmp_img"
        return 0
    fi

    if apply_image_to_linux "$tmp_img"; then
        with_lock write_image_hash "$current_hash"
        log_info "← Linux image [push]"
        notify_linux "Clipboard Sync [IMAGE]" "Image copied"
    else
        log_error "← wl-copy image failed"
        rm -f "$tmp_img"
        return 1
    fi
    rm -f "$tmp_img"
}

# Legacy: IMG:<base64> (small images / old daemon)
apply_macos_img_b64() {
    local b64="$1"
    local tmp_img="$TEMP_DIR/macos_b64.$$.png"
    if ! printf '%s' "$b64" | base64 -d > "$tmp_img" 2>/dev/null || [[ ! -s "$tmp_img" ]]; then
        rm -f "$tmp_img"
        log_warn "← invalid IMG base64"
        return 1
    fi
    local current_hash
    current_hash=$(get_image_hash "$tmp_img")
    local last
    last=$(read_image_hash)
    if [[ "$current_hash" == "$last" ]]; then
        rm -f "$tmp_img"
        return 0
    fi
    if apply_image_to_linux "$tmp_img"; then
        with_lock write_image_hash "$current_hash"
        log_info "← Linux image [push-b64]"
        notify_linux "Clipboard Sync [IMAGE]" "Image copied"
    else
        log_error "← wl-copy image failed"
        rm -f "$tmp_img"
        return 1
    fi
    rm -f "$tmp_img"
}

handle_fifo_line() {
    local line="$1"
    [[ -z "$line" ]] && return 0

    case "$line" in
        TEXT:*)
            [[ "$ENABLE_TEXT" == "true" ]] || return 0
            apply_macos_text_payload "${line#TEXT:}" || true
            ;;
        IMGFILE:*)
            [[ "$ENABLE_IMAGE" == "true" ]] || return 0
            apply_macos_imgfile "${line#IMGFILE:}" || true
            ;;
        IMG:*)
            [[ "$ENABLE_IMAGE" == "true" ]] || return 0
            apply_macos_img_b64 "${line#IMG:}" || true
            ;;
        PING|ping)
            log_debug "← fifo ping"
            ;;
        *)
            # Unknown / truncated — treat as wake-up and fall back to one pull
            log_warn "← unknown fifo event (len=${#line}); safety pull"
            pull_macos_text_once || true
            ;;
    esac
}

run_inbound_fifo_worker() {
    log_info "Inbound worker: Mac FIFO push stream ($MACOS_EVENT_FIFO)"
    local backoff=1
    local max_backoff=60
    # Remote probe + line-buffered stream.
    # Plain `cat` fully-buffers stdout when piped over SSH, so small TEXT lines
    # can sit for seconds (often ~4–8KiB buffer) — the main Mac→Linux lag cause.
    # Prefer stdbuf -oL, else perl ($|=1), else python3 -u. Exit 2 = FIFO missing.
    local remote_fifo_cmd
    # shellcheck disable=SC2087
    remote_fifo_cmd=$(cat <<EOF
if [ ! -p '${MACOS_EVENT_FIFO}' ]; then
  echo "FIFO missing at ${MACOS_EVENT_FIFO} — start clipboard-sync-daemon on Mac (launchctl load ~/Library/LaunchAgents/clipboard-sync.daemon.plist), or set macos_event_mode=polling on Linux" >&2
  exit 2
fi
if command -v stdbuf >/dev/null 2>&1; then
  exec stdbuf -oL cat '${MACOS_EVENT_FIFO}'
elif command -v perl >/dev/null 2>&1; then
  exec perl -e '\$|=1; open my \$f, "<", \$ARGV[0] or die \$!; while (<\$f>) { print; }' '${MACOS_EVENT_FIFO}'
else
  exec python3 -u -c 'import sys; f=open(sys.argv[1]);
while True:
    line=f.readline()
    if not line: break
    sys.stdout.write(line); sys.stdout.flush()' '${MACOS_EVENT_FIFO}'
fi
EOF
)

    while true; do
        if ! ensure_ssh_master; then
            log_error "inbound: SSH master down; retry in ${backoff}s"
            sleep "$backoff"
            backoff=$(( backoff * 2 ))
            [[ $backoff -gt $max_backoff ]] && backoff=$max_backoff
            continue
        fi

        local socket=""
        local errf="$TEMP_DIR/fifo_stream.err"
        local sawf="$TEMP_DIR/fifo_stream.saw"
        : > "$errf"
        : > "$sawf"

        # Long-lived SSH that streams FIFO events with payload.
        # Guard pipeline: with set -euo pipefail an unguarded failed ssh|while
        # would kill this worker (and used to take down the whole daemon).
        # Reset reconnect backoff when starting a live stream attempt.
        backoff=1
        local rc=0
        set +e
        if [[ "$SSH_MUX_ENABLED" == "true" ]]; then
            socket=$(get_ssh_socket)
            # shellcheck disable=SC2086
            ssh -S "$socket" -T $SSH_OPTS "$REMOTE_USER@$REMOTE_HOST" \
                "$remote_fifo_cmd" \
                2>"$errf" | while IFS= read -r line || [[ -n "$line" ]]; do
                    echo 1 > "$sawf"
                    handle_fifo_line "$line"
                done
            rc=${PIPESTATUS[0]:-1}
        else
            # shellcheck disable=SC2086
            ssh -T $SSH_OPTS "$REMOTE_USER@$REMOTE_HOST" \
                "$remote_fifo_cmd" \
                2>"$errf" | while IFS= read -r line || [[ -n "$line" ]]; do
                    echo 1 > "$sawf"
                    handle_fifo_line "$line"
                done
            rc=${PIPESTATUS[0]:-1}
        fi
        set -euo pipefail

        local err
        err=$(tr '\n' ' ' < "$errf" 2>/dev/null || true)
        local saw_data=0
        [[ -s "$sawf" ]] && saw_data=1
        if [[ $rc -eq 2 ]] || [[ "$err" == *"FIFO missing"* ]]; then
            log_error "Mac FIFO unavailable at $MACOS_EVENT_FIFO (clipboard-sync-daemon not running?). Outbound keeps working; inbound will retry in ${backoff}s. Fix: start Mac daemon, or set macos_event_mode=polling.${err:+ Detail: $err}"
        elif [[ $rc -ne 0 ]]; then
            log_warn "inbound FIFO stream ended (rc=$rc); reconnecting in ${backoff}s${err:+ — $err}"
        else
            log_warn "inbound FIFO stream closed; reconnecting in ${backoff}s${err:+ — $err}"
        fi

        # Successful traffic keeps reconnect snappy; only grow backoff when the
        # stream never delivered data (missing FIFO / hard SSH failures).
        if [[ $saw_data -eq 1 ]]; then
            backoff=1
        fi

        sleep "$backoff"
        if [[ $saw_data -eq 0 && $rc -ne 0 ]]; then
            backoff=$(( backoff * 2 ))
            [[ $backoff -gt $max_backoff ]] && backoff=$max_backoff
        else
            backoff=1
        fi
        ensure_ssh_master || true
    done
}

# Polling fallback for Mac → Linux
pull_macos_text_once() {
    [[ "$ENABLE_TEXT" == "true" ]] || return 0
    ensure_ssh_master || return 1
    local mac_text
    mac_text=$(ssh_run "export LC_CTYPE=en_US.UTF-8; pbpaste" || true)
    [[ ${#mac_text} -ge $MIN_LENGTH ]] || return 0
    mac_text=$(ensure_utf8 "$mac_text")
    local current_hash
    current_hash=$(get_text_hash "$mac_text")
    local last
    last=$(read_text_hash)
    [[ "$current_hash" == "$last" ]] && return 0
    if apply_text_to_linux "$mac_text"; then
        with_lock write_text_hash "$current_hash"
        log_info "← Linux text (${#mac_text} chars) [poll]"
        notify_linux "Clipboard Sync" "$mac_text"
    fi
}

pull_macos_image_once() {
    [[ "$ENABLE_IMAGE" == "true" ]] || return 0
    [[ -n "$MACOS_IMAGE_COPY_PATH" ]] || return 0
    ensure_ssh_master || return 1

    local mac_path tmp_img
    mac_path=$(ssh_run "$MACOS_IMAGE_COPY_PATH -o /tmp/clipboard_pull_$$.png >/dev/null && echo /tmp/clipboard_pull_$$.png" || true)
    [[ -n "$mac_path" ]] || return 0
    [[ "$mac_path" == /tmp/* ]] || return 1

    tmp_img="$TEMP_DIR/macos_poll.$$.png"
    scp_from "$mac_path" "$tmp_img" || return 1
    ssh_run "rm -f $mac_path" || true
    [[ -s "$tmp_img" ]] || { rm -f "$tmp_img"; return 0; }

    local current_hash last
    current_hash=$(get_image_hash "$tmp_img")
    last=$(read_image_hash)
    if [[ "$current_hash" != "$last" ]]; then
        if apply_image_to_linux "$tmp_img"; then
            with_lock write_image_hash "$current_hash"
            log_info "← Linux image [poll]"
            notify_linux "Clipboard Sync [IMAGE]" "Image copied"
        fi
    fi
    rm -f "$tmp_img"
}

run_inbound_poll_worker() {
    log_info "Inbound worker: polling every ${POLL_INTERVAL}s (install Mac daemon for push)"
    while true; do
        pull_macos_text_once || true
        pull_macos_image_once || true
        sleep "$POLL_INTERVAL"
    done
}

# Rare safety net when push mode is active
run_safety_net_worker() {
    local interval="$POLL_INTERVAL"
    [[ "$interval" -lt 15 ]] && interval=30
    log_info "Safety-net poll every ${interval}s"
    while true; do
        sleep "$interval"
        ensure_ssh_master || continue
        pull_macos_text_once || true
        # Image safety net is heavier; only every other cycle-ish by sleeping more
        pull_macos_image_once || true
    done
}

# === ONE-SHOT COMMANDS ===
cmd_sync_to() {
    if [[ "$SSH_MUX_ENABLED" == "true" ]]; then
        ensure_ssh_master || {
            log_warn "SSH multiplexing setup failed, using direct connection"
            SSH_MUX_ENABLED="false"
        }
    fi
    if ! check_connection; then
        echo "Error: cannot connect to $REMOTE_USER@$REMOTE_HOST" >&2
        return 1
    fi

    if [[ "$ENABLE_IMAGE" == "true" ]]; then
        local image_type
        image_type=$(timeout 2 wl-paste --list-types 2>/dev/null | grep -m1 "image/" || echo "")
        if [[ -n "$image_type" ]]; then
            local tmp_img="$TEMP_DIR/sync_to.$$.${image_type#image/}"
            if timeout 2 wl-paste --type "$image_type" > "$tmp_img" 2>/dev/null && [[ -s "$tmp_img" ]]; then
                if push_image_to_macos "$tmp_img"; then
                    local h
                    h=$(get_image_hash "$tmp_img")
                    with_lock write_image_hash "$h"
                    rm -f "$tmp_img"
                    notify_macos "Clipboard Sync" "Image received from Linux"
                    echo "Image synced to macOS"
                    return 0
                fi
                rm -f "$tmp_img"
                echo "Error: failed to push image to macOS" >&2
                return 1
            fi
            rm -f "$tmp_img"
        fi
    fi

    if [[ "$ENABLE_TEXT" == "true" ]]; then
        local linux_text
        linux_text=$(timeout 2 wl-paste -t text/plain 2>/dev/null || echo "")
        if [[ ${#linux_text} -ge $MIN_LENGTH ]]; then
            linux_text=$(ensure_utf8 "$linux_text")
            if push_text_to_macos "$linux_text"; then
                with_lock write_text_hash "$(get_text_hash "$linux_text")"
                notify_macos "Clipboard Sync" "$linux_text"
                echo "Text synced to macOS (${#linux_text} chars)"
                return 0
            fi
            echo "Error: failed to push text to macOS" >&2
            return 1
        fi
    fi

    echo "Nothing to sync (clipboard empty or below min length)"
    return 0
}

cmd_sync_from() {
    if [[ "$SSH_MUX_ENABLED" == "true" ]]; then
        ensure_ssh_master || {
            log_warn "SSH multiplexing setup failed, using direct connection"
            SSH_MUX_ENABLED="false"
        }
    fi
    if ! check_connection; then
        echo "Error: cannot connect to $REMOTE_USER@$REMOTE_HOST" >&2
        return 1
    fi

    if [[ "$ENABLE_IMAGE" == "true" ]] && [[ -n "$MACOS_IMAGE_COPY_PATH" ]]; then
        local mac_path tmp_img
        mac_path=$(ssh_run "$MACOS_IMAGE_COPY_PATH -o /tmp/clipboard_pull_$$.png >/dev/null && echo /tmp/clipboard_pull_$$.png" || true)
        if [[ -n "$mac_path" ]] && [[ "$mac_path" == /tmp/* ]]; then
            tmp_img="$TEMP_DIR/sync_from.$$.png"
            if scp_from "$mac_path" "$tmp_img" && [[ -s "$tmp_img" ]]; then
                ssh_run "rm -f $mac_path" || true
                if apply_image_to_linux "$tmp_img"; then
                    with_lock write_image_hash "$(get_image_hash "$tmp_img")"
                    rm -f "$tmp_img"
                    notify_linux "Clipboard Sync [IMAGE]" "Image copied"
                    echo "Image synced from macOS"
                    return 0
                fi
            fi
            rm -f "$tmp_img"
            ssh_run "rm -f $mac_path" || true
        fi
    fi

    if [[ "$ENABLE_TEXT" == "true" ]]; then
        local mac_text
        mac_text=$(ssh_run "export LC_CTYPE=en_US.UTF-8; pbpaste" || true)
        if [[ ${#mac_text} -ge $MIN_LENGTH ]]; then
            mac_text=$(ensure_utf8 "$mac_text")
            if apply_text_to_linux "$mac_text"; then
                with_lock write_text_hash "$(get_text_hash "$mac_text")"
                notify_linux "Clipboard Sync" "$mac_text"
                echo "Text synced from macOS (${#mac_text} chars)"
                return 0
            fi
            echo "Error: failed to copy text to Linux clipboard" >&2
            return 1
        fi
    fi

    echo "Nothing to sync from macOS (clipboard empty or below min length)"
    return 0
}

show_usage() {
    cat << 'EOF'
Usage: clipboard-sync [COMMAND]

Commands:
  (none)     Run push-oriented daemon (parallel inbound + outbound workers)
  sync-to    Push Linux clipboard to macOS (one-shot)
  sync-from  Pull macOS clipboard to Linux (one-shot)

Options:
  -h, --help  Show this help

Configuration: ~/.config/clipboard-sync/config.ini
State:         ~/.local/state/clipboard-sync/

Push architecture:
  Linux watches Wayland and pushes over SSH ControlMaster.
  macOS clipboard-sync-daemon pushes TEXT:/IMGFILE: events on a FIFO;
  Linux applies payloads immediately (no second SSH pull for text).

Set DEBUG=true for verbose logs. journalctl --user -u clipboard-sync -f
EOF
}

# === DAEMON SUPERVISOR ===
run_daemon() {
    setup

    if [[ "$SSH_MUX_ENABLED" == "true" ]]; then
        if ensure_ssh_master; then
            log_info "SSH multiplexing ready (persist ${SSH_MUX_PERSIST}s)"
        else
            log_warn "SSH multiplexing failed; direct connections (higher latency)"
            SSH_MUX_ENABLED="false"
        fi
    fi

    log_info "Clipboard sync v2 push daemon"
    log_info "Remote: $REMOTE_USER@$REMOTE_HOST"
    log_info "Mode: macos_event_mode=$MACOS_EVENT_MODE  text=$ENABLE_TEXT  image=$ENABLE_IMAGE"

    # Export config for subshells that call functions (same bash process via background jobs
    # inherit functions when we use job control in this script — we start workers as
    # background functions in this shell.)

    # Outbound worker
    if wayland_watch_available; then
        run_outbound_watch_worker &
        OUTBOUND_PID=$!
    else
        run_outbound_poll_worker &
        OUTBOUND_PID=$!
    fi
    log_info "Outbound worker pid=$OUTBOUND_PID"

    # Inbound worker
    if [[ "$MACOS_EVENT_MODE" == "fifo" ]]; then
        run_inbound_fifo_worker &
        INBOUND_PID=$!
        run_safety_net_worker &
        SAFETY_PID=$!
        log_info "Inbound FIFO worker pid=$INBOUND_PID safety=$SAFETY_PID"
    else
        run_inbound_poll_worker &
        INBOUND_PID=$!
        log_info "Inbound poll worker pid=$INBOUND_PID"
    fi

    # Supervise workers. Outbound death is fatal (systemd restarts us).
    # Inbound / safety death must NOT tear down the daemon — reconnect with backoff
    # so Linux→Mac keeps working when Mac FIFO/daemon is missing.
    local inbound_backoff=1
    local inbound_max_backoff=60
    while true; do
        if ! kill -0 "$OUTBOUND_PID" 2>/dev/null; then
            log_error "Outbound worker died"
            wait "$OUTBOUND_PID" 2>/dev/null || true
            exit 1
        fi
        if ! kill -0 "$INBOUND_PID" 2>/dev/null; then
            wait "$INBOUND_PID" 2>/dev/null || true
            log_error "Inbound worker exited; restarting in ${inbound_backoff}s (outbound + safety poll keep running). If this repeats: start Mac clipboard-sync-daemon, or set macos_event_mode=polling"
            sleep "$inbound_backoff"
            inbound_backoff=$(( inbound_backoff * 2 ))
            [[ $inbound_backoff -gt $inbound_max_backoff ]] && inbound_backoff=$inbound_max_backoff
            if [[ "$MACOS_EVENT_MODE" == "fifo" ]]; then
                run_inbound_fifo_worker &
            else
                run_inbound_poll_worker &
            fi
            INBOUND_PID=$!
            log_info "Inbound worker restarted pid=$INBOUND_PID"
        else
            inbound_backoff=1
        fi
        if [[ -n "$SAFETY_PID" ]] && ! kill -0 "$SAFETY_PID" 2>/dev/null; then
            log_warn "Safety-net worker died; restarting"
            run_safety_net_worker &
            SAFETY_PID=$!
        fi
        # Refresh mux periodically
        ensure_ssh_master || log_warn "SSH master refresh failed"
        sleep 5
    done
}

main() {
    parse_config "$CONFIG_FILE" || true

    case "${1:-}" in
        sync-to)
            setup
            validate_config || exit 1
            cmd_sync_to
            exit $?
            ;;
        sync-from)
            setup
            validate_config || exit 1
            cmd_sync_from
            exit $?
            ;;
        -h|--help)
            show_usage
            exit 0
            ;;
        "")
            trap cleanup EXIT
            trap handle_shutdown INT TERM
            validate_config || exit 1
            run_daemon
            ;;
        *)
            echo "Unknown command: $1" >&2
            show_usage >&2
            exit 1
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
