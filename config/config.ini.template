# Clipboard Sync Configuration
# Copy to ~/.config/clipboard-sync/config.ini and edit.

[remote]
# macOS SSH target
user = YOUR_MAC_USERNAME
host = YOUR_MAC_HOSTNAME_OR_IP
# Path to imagecopy helper on macOS (required for Linux → macOS images)
image_copy_path = /Users/YOUR_MAC_USERNAME/scripts/imagecopy

[sync]
# Minimum text length to sync
min_length = 1
# Safety-net poll interval in seconds (push mode uses this rarely; poll mode uses it as primary)
poll_interval = 30
enable_text = true
enable_image = true
# Use wl-paste --watch for Linux → macOS (falls back to polling if unavailable)
use_wayland_watch = true
# macOS → Linux: fifo (push, recommended) or polling
macos_event_mode = fifo
# FIFO path must match clipboard-sync-daemon --fifo-path on the Mac
macos_event_fifo = /tmp/clipboard-sync.fifo
# PNG path written by the Mac daemon for IMGFILE events
macos_push_image = /tmp/clipboard-sync-push.png
# Only used when macos_event_mode = polling
macos_image_check_interval = 5

[notifications]
enabled = true

[ssh]
options = -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3
# Persistent ControlMaster — required for low-latency push
mux_enabled = true
# Keep master alive after last use (seconds)
mux_persist = 600
